{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"noEmit": true,
		"skipLibCheck": true,
		"paths": {
			"@/*": ["./src/*"]
		},
		"types": ["vite/client", "bun"],
		"verbatimModuleSyntax": true
	},
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules", "dist", ".output"]
}
